# Provedores de IA para geração de texto. A ordem de prioridade é:
# 1) Gemini (se GEMINI_API_KEY) -> 2) OpenAI (se OPENAI_API_KEY) -> 3) modo demo.
# Sem nenhuma chave, o app roda em "modo demo" (texto gerado por modelo local de exemplo).

# Google Gemini (tem camada gratuita): crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo opcional (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI: crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo opcional (padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Publicação no Instagram (Reels) via Meta Graph API ---
# Crie um app em https://developers.facebook.com/apps (tipo Empresa) e adicione
# os produtos "Login do Facebook" e "Instagram Graph API".
# Em Configurações > Básico você encontra o App ID e o App Secret.
META_APP_ID=
META_APP_SECRET=

# Armazenamento do vídeo para gerar uma URL pública (exigência da API do Instagram).
# Na Vercel: Storage > Create > Blob. O token abaixo é criado automaticamente.
BLOB_READ_WRITE_TOKEN=
